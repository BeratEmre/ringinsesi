{
  "expo": {
    "owner": "ringinsesi",
    "name": "ringinsesi",
    "slug": "ringinsesi",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/logo_kare.png",
    "scheme": "ringinsesi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./assets/file/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ringinsesi_icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.beft9.ringinsesi",
      "versionCode": 12
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/ringinsesi_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "46cd2abb-473d-43b4-a782-64f5e4f3f228"
      }
    }
  }
}
